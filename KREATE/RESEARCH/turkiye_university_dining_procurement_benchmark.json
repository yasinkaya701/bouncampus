  "patterns": [
    {
      "id": "MKT-01",
      "claim": "Food-service procurement repeatedly sits in SKS or another identifiable university administrative authority.",
      "use": "Narrow buyer-discovery targets beyond generic university management."
    },
    {
      "id": "MKT-02",
      "claim": "Explicit meal/service quantities recur across sampled procurements.",
      "use": "Treat quantity as an existing operational/procurement object, while validating whether daily quantities are adjustable."
    },
    {
      "id": "MKT-03",
      "claim": "Operating modes vary across on-site production, transported food, multi-site distribution, meal types, dietary variants and package channels.",
      "use": "Require a configurable canonical schema rather than a single cafeteria-specific model."
    },
    {
      "id": "MKT-04",
      "claim": "Procurement/contract rules can materially constrain the value of a forecast recommendation.",
      "use": "Combine forecast with contract, shortage and service constraints before recommending quantity."
    },
    {
      "id": "MKT-05",
      "claim": "Institution-specific operational data systems are likely heterogeneous even when procurement patterns repeat.",
      "use": "Separate canonical internal schema from institution-specific adapters."
    }
  ],
