# BOUNCAMPUS FastAPI configuration
ENVIRONMENT=development
APP_VERSION=1.0.0-beta
DATABASE_URL=sqlite:///./data/db/campus.db

# Production example:
# CORS_ORIGINS=["https://your-bouncampus-project.vercel.app"]
