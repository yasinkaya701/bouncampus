# Leave empty to use the co-located Next.js /api/v1 routes.
NEXT_PUBLIC_API_URL=

# Optional canonical production origin. On Vercel this can be omitted because
# VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL are resolved automatically server-side.
# NEXT_PUBLIC_SITE_URL=https://bouncampus.example.com

# If the FastAPI research service is ever deployed separately, set for example:
# NEXT_PUBLIC_API_URL=https://api.example.com
