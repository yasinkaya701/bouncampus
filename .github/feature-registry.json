{
  "schema_version": 1,
  "features": [
    {
      "id": "dashboard-api",
      "required_paths": [
        "frontend/src/app/api/v1/dashboard/route.ts",
        "frontend/src/lib/types.ts"
      ]
    },
    {
      "id": "mission-brief-api",
      "required_paths": [
        "frontend/src/app/api/v1/brief/route.ts",
        "frontend/src/lib/mission-types.ts"
      ]
    },
    {
      "id": "campus-building-directory",
      "required_paths": [
        "frontend/src/lib/campus-directory.ts",
        "frontend/src/app/buildings/page.tsx",
        "frontend/src/app/buildings/[id]/page.tsx"
      ]
    },
    {
      "id": "source-backed-building-locations",
      "required_paths": [
        "frontend/src/app/api/v1/building-locations/route.ts"
      ]
    },
    {
      "id": "campus-geometry-api",
      "required_paths": [
        "frontend/src/app/api/v1/campus-geometry/route.ts",
        "frontend/src/lib/campus-geometry.ts"
      ]
    },
    {
      "id": "campus-map-3d",
      "required_paths": [
        "frontend/src/components/Dashboard/CampusMap.tsx",
        "frontend/src/components/Dashboard/CampusMap3D.tsx"
      ]
    },
    {
      "id": "bilingual-ui-core",
      "required_paths": [
        "frontend/src/lib/i18n.tsx",
        "frontend/src/components/shared/Header.tsx",
        "frontend/src/components/shared/Footer.tsx"
      ]
    },
    {
      "id": "campus-visual-assets",
      "required_paths": [
        "frontend/public/assets/bouncampus-hero.svg",
        "frontend/public/assets/building-placeholder.svg",
        "frontend/public/assets/campus-topography.svg",
        "frontend/public/assets/map-pin-academic.svg"
      ]
    },
    {
      "id": "shuttle-mobility-network",
      "required_paths": [
        "frontend/src/lib/shuttle-network.ts",
        "frontend/src/app/api/v1/shuttles/route.ts",
        "frontend/src/components/Mobility/ShuttleNetwork.tsx",
        "frontend/src/app/mobility/page.tsx"
      ]
    },
    {
      "id": "multi-agent-coordination-runtime",
      "required_paths": [
        ".agents/config.json",
        ".agents/PROTOCOL.md",
        "scripts/agent_bus.py",
        "scripts/test_agent_bus.py",
        ".github/workflows/agent-coordination.yml"
      ]
    }
  ]
}
